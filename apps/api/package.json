{
  "name": "@wallet-system/api",
  "version": "1.0.0",
  "description": "PurpleWallet REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "admin:grant": "node -r ts-node/register src/scripts/admin-role.ts grant",
    "admin:revoke": "node -r ts-node/register src/scripts/admin-role.ts revoke",
    "seed:demo": "node -r ts-node/register src/scripts/dev/seed-demo.ts",
    "eval:assistant": "node -r ts-node/register src/scripts/dev/eval-assistant.ts",
    "admin:grant:prod": "node dist/scripts/admin-role.js grant",
    "admin:revoke:prod": "node dist/scripts/admin-role.js revoke",
    "test": "cross-env NODE_ENV=test npx jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test npx jest --runInBand --coverage"
  },
  "keywords": [],
  "author": "Tochukwu Amaechina",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.9.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
