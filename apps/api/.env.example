# ==============================
# 🌐 APP CONFIGURATION
# ==============================
NODE_ENV=development          # development | test | production
PORT=4000

# ==============================
# 🗄 DATABASE (PostgreSQL via Prisma)
# ==============================
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DB_NAME?schema=public

# ==============================
# 🔴 REDIS
# ==============================
REDIS_URL=redis://localhost:6380

# ==============================
# 🔐 AUTHENTICATION
# ==============================
# Must be at least 32 characters in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==============================
# 🌍 CORS
# ==============================
# Comma-separated list of browser origins allowed to call the API.
# Defaults to the Vite dev server (http://localhost:5173) when unset.
CORS_ORIGINS=http://localhost:5173

# ==============================
# 💳 PAYSTACK (payments)
# ==============================
# Secret key from the Paystack dashboard (Settings → API Keys & Webhooks).
# Use sk_test_… while developing. Payments return 503 until this is set.
PAYSTACK_SECRET_KEY=
# Where Paystack sends users after checkout: the web app's deposit callback page
PAYSTACK_CALLBACK_URL=http://localhost:5173/deposit/callback
# Development only: simulate payouts (recipients + transfers) until your Paystack account is
# approved for transfers. Amounts ending in .13 fail, to exercise refunds.
# Refused in production and with a live key.
PAYSTACK_SIMULATE_PAYOUTS=false

# ==============================
# ✉️ EMAIL
# ==============================
# "resend" (default), "gmail" or "gmail-script". With no provider set up, emails are logged instead of sent
# (and development prints verification links in the API log).
EMAIL_PROVIDER=resend

# Gmail: free, reaches anyone, about 500 emails a day, no domain needed. Use a Gmail account
# just for this app: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords (not the account password). Emails show as
# "PurpleWallet <GMAIL_USER>". Check the setup with: npm run email:test -w apps/api -- you@example.com
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gmail relay ("gmail-script"): for hosts that block outgoing SMTP, such as Render's free plan.
# A Google Apps Script in the Gmail account (apps/api/scripts/gmail-relay.gs) sends the emails;
# the API calls it over HTTPS. About 100 recipients a day. Setup: DEPLOYMENT.md, step 3.
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=

# Resend: needs a domain verified in Resend to email anyone but yourself.
RESEND_API_KEY=
# Must be on a domain verified in Resend. The shared onboarding@resend.dev sender only
# delivers to your own Resend account address (fine for development).
EMAIL_FROM=PurpleWallet <onboarding@resend.dev>
# The web app's address, used for links in emails (including password reset links,
# which point at APP_URL/reset-password)
APP_URL=http://localhost:5173

# ==============================
# ✨ AI INSIGHTS (Google Gemini)
# ==============================
# Key from https://aistudio.google.com. Without it, insights use plain template sentences.
# Free tier: Google may use the data to improve its products. Names are pseudonymised either way,
# but use a paid (billing-enabled) key for real users.
GEMINI_API_KEY=
# Writes the insight text
GEMINI_MODEL=gemini-3.8-flash
# Categorises transactions, and is the fallback writer if GEMINI_MODEL is overloaded.
# A separate model has its own free-tier quota.
GEMINI_CATEGORY_MODEL=gemini-3.5-flash-lite

# ==============================
# 🪪 ID CHECKS (TIER UPGRADES)
# ==============================
# Encrypts uploaded ID photos and ID numbers: 32 random bytes, base64. REQUIRED in production;
# keep it secret and never change it once documents exist (they become unreadable). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, development uses a fixed, insecure key.
KYC_ENCRYPTION_KEY=

# Where the app's "Help & support" link goes. Defaults to the address emails come from.
SUPPORT_EMAIL=

# ==============================
# 🔒 DIRECT FUNDING
# ==============================
# Allows POST /api/wallet/credit, /api/wallet/debit and user-initiated reversals, which move
# money with no real payment behind them. Defaults to true outside production and false in
# production; set it explicitly to override.
# DIRECT_FUNDING_ENABLED=true

# ==============================
# 📋 LOGGING (optional)
# ==============================
# One of: fatal | error | warn | info | debug | trace | silent
# Defaults to "debug" in development, "info" in production/test
LOG_LEVEL=debug

# ==============================
# 🐳 DOCKER (postgres container)
# ==============================
POSTGRES_USER=USERNAME
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DB_NAME
